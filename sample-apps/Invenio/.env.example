# ══════════════════════════════════════════════════
# Invenio — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════

# ─── Application ──────────────────────────────────
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR

# ─── Frontend (Vite) ──────────────────────────────
# Prefix with VITE_ to expose to the browser
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=Invenio

# ─── Backend Database (Supabase) ──────────────────
# Phase 2
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/invenio

# ─── Graph Database (Neo4j) ───────────────────────
# Phase 2
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ─── Cache (Redis) ────────────────────────────────
# Phase 2
REDIS_URL=redis://localhost:6379

# ─── Security ─────────────────────────────────────
# Phase 3
SECRET_KEY=your_secret_key_min_32_chars_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── CORS ─────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── External APIs ────────────────────────────────
# Phase 2
NITROSTACK_API_KEY="your_nitrostack_key_here"
OPENALEX_EMAIL="your_email@example.com"
GITHUB_TOKEN="your_github_token_here"
KAGGLE_USERNAME="your_kaggle_username"
KAGGLE_KEY="your_kaggle_key_here"
HUGGINGFACE_TOKEN="your_huggingface_token_here"
SEMANTIC_SCHOLAR_API_KEY=
